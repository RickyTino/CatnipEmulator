# Build output
build/

# Executables (cemu in the project root, the test binaries in tb/)
/cemu
/tb/nscscc_tests
/tb/uart_test
/tb/eth_test

# Editor / scratch
.vscode/
temp/

# Safety net
*.o
*.d
*.a
*.log
*.exe

# Test-program build output under tb/soft.  The harness needs the three ELF
# images it loads at run time (func / perf allbench / tlb_func) plus
# tb/soft/func/golden_trace.txt, so those stay tracked; everything else the
# toolchain generates (hex/COE/MIF dumps, disassembly, per-benchmark ELFs)
# does not.
*.mif
*.coe
*.bin
*.data
tb/soft/*/convert
tb/soft/**/test.s
tb/soft/**/obj/**/main.elf
!tb/soft/func/obj/main.elf
!tb/soft/perf_func/obj/allbench/main.elf
!tb/soft/tlb_func/obj/main.elf

# Our own legacy TLB test: keep the sources (test.S, ram.ld, convert.py,
# Makefile), ignore the build products.
tb/legacy/tlb_test/tlb_test.*
